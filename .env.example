# 이 파일을 .env로 복사하고 값을 넣는다.
# .env에는 키가 들어가므로 공유하거나 저장소에 올리지 않는다 (.gitignore에 있음).

# Gemini API 키 (AI Studio에서 발급). 결제 계정은 연결하지 않는다.
GEMINI_API_KEY=

# 정확한 모델 ID. latest·preview 별칭, 폐지됐거나 폐지 예정인 모델은 쓰지 않는다.
# 기본: gemini-3.1-flash-lite (개발·반복 실행). 비교: gemini-3.5-flash-lite. gemini-3.8-flash는 아직 시험하지 못했다(정책 18-1)
GEMINI_MODEL=gemini-3.1-flash-lite

# 무료 티어 한도. 모델마다 다르다. 실행 전에 AI Studio의 Rate Limit 화면 값으로 맞춘다.
# (2026-11-04 화면: gemini-3.1-flash-lite·gemini-3.5-flash-lite RPM 15 / RPD 500, gemini-3.8-flash RPM 5 / RPD 20)
GEMINI_RPM=15
GEMINI_RPD=500
